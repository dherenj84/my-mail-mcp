# One JSON list; one entry per mailbox. See README "Multiple mailboxes" for more examples.
# Optional per-account keys: imap_host, imap_port, smtp_host, smtp_port, smtp_starttls,
# archive_folder, trash_folder, sent_folder, save_sent_copy. Yahoo hosts are the defaults.
MAIL_ACCOUNTS='[{"id":"yahoo","username":"you@yahoo.com","password":"replace-with-yahoo-app-password"}]'
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
PORT=8080
